{
  "name": "the-best-auto-refresh-app",
  "version": "1.3.1",
  "private": true,
  "description": "Engine and tests for The Best Auto Refresh App Chrome extension (vanilla JS, no runtime dependencies).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "cws:auth": "node scripts/cws-auth.mjs",
    "cws:status": "node scripts/publish-cws.mjs status",
    "cws:upload": "node scripts/publish-cws.mjs upload",
    "cws:release": "node scripts/publish-cws.mjs release",
    "cws:check": "node scripts/publish-cws.mjs upload --dry-run"
  }
}
